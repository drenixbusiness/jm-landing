# Copy to .env.local and fill in.

# Telegram: every form submission is posted to this chat (fields as a message, uploaded files as documents).
# Create a bot with @BotFather, add it to the group, and use the group's chat id (negative number).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: also forward every submission (fields + files) as multipart/form-data to this URL.
LEAD_WEBHOOK_URL=

# CARTO basemaps key for the About page map (public, used in the browser).
NEXT_PUBLIC_CARTO_KEY=
